# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# PostgreSQL connection string
DATABASE_URL=postgres://lslbot:password@127.0.0.1:5432/lslbot

# Leave empty to run in long-polling mode (recommended for a single VPS).
# Set to the public HTTPS base URL to run in webhook mode instead.
WEBHOOK_URL=

# HTTP port for the /health endpoint (and webhook endpoint when WEBHOOK_URL is set)
PORT=3009
