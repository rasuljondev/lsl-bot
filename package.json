{
  "name": "lsl-bot",
  "version": "1.2.0",
  "description": "Telegram Attendance Bot for LSL School",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "test": "node --test --test-concurrency=1",
    "db:migrate": "node scripts/migrate.js",
    "roster:import": "node scripts/import-roster.js",
    "roster:check": "node scripts/check-rosters.js",
